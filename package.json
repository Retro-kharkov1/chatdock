{
  "name": "google-chat-desktop",
  "version": "0.1.0",
  "description": "Electron desktop client for Google Chat - persistent Google login, native system notifications, tray-minimize.",
  "author": "Retro-kharkov1",
  "homepage": "https://github.com/Retro-kharkov1/google-chat-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Retro-kharkov1/google-chat-desktop.git"
  },
  "private": true,
  "license": "UNLICENSED",
  "main": "src/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "generate-build-info": "node scripts/generate-build-info.js",
    "pack": "node scripts/build.js --dir",
    "dist": "node scripts/build.js"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.retro-kharkov1.google-chat-desktop",
    "productName": "Google Chat Desktop",
    "beforePack": "scripts/beforePack.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/icons/**/*",
      "assets/tray/**/*",
      "package.json",
      "build-info.json"
    ],
    "publish": {
      "provider": "github"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons/icon.png",
      "category": "Network",
      "maintainer": "95210642+Retro-kharkov1@users.noreply.github.com",
      "executableName": "google-chat-desktop",
      "desktop": {
        "entry": {
          "Name": "Google Chat Desktop",
          "StartupWMClass": "Google Chat Desktop"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2"
      ]
    },
    "appImage": {
      "artifactName": "Google-Chat-Desktop-${version}.${ext}"
    }
  }
}
